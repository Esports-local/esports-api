# cp .env.example .env  — 컴퓨터(맥 / 워크스테이션)마다 .env 만 다르게 둔다.
# 이 파일은 docker compose 변수(COMPOSE_PROFILES, VIDEOS_DIR 등)와 api 컨테이너 환경변수를 겸한다.

# 이 컴퓨터에서 MinIO 를 띄울지. 다른 곳의 저장소를 쓰면 비운다 (COMPOSE_PROFILES=)
COMPOSE_PROFILES=minio

# add_videos 가 읽을 원본 영상 폴더 (호스트 경로 → 컨테이너 /videos)
# 예: Google Drive for desktop 폴더 ~/Library/CloudStorage/GoogleDrive-<계정>/내 드라이브/videos
VIDEOS_DIR=./videos

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Postgres (db 컨테이너 초기값 겸용)
POSTGRES_USER=vod
POSTGRES_PASSWORD=vod
POSTGRES_DB=vod
DATABASE_URL=postgres://vod:vod@db:5432/vod

# 저장소 (S3 호환: MinIO / 나중에 GCS 등). main 도 같은 이름을 쓴다
# - 이 컴퓨터의 MinIO:        S3_ENDPOINT_URL=http://minio:9000
# - 다른 컴퓨터의 MinIO:      S3_ENDPOINT_URL=http://<그 컴퓨터 IP>:9000  (COMPOSE_PROFILES 비움)
# api 컨테이너 → MinIO
S3_ENDPOINT_URL=http://minio:9000
# 브라우저가 쓰는 presigned URL 주소 (서명에 host 가 들어가므로 따로 둔다)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vod
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES=3600

# 다른 서비스
# 분석 워커 (test_main)
MAIN_URL=http://host.docker.internal:8001
# main 이 callback 할 api 주소
API_URL=http://host.docker.internal:8000

# 예측 백엔드. mock = LLM 없이 가짜 결과 (ui 개발용)
PREDICT_BACKEND=mock

# ─── TMDB (작품·회차·등장인물 정보, 배우 사진) ───────────────
# 비상업 무료. 실제 값은 .env 에만 넣는다 (git 에 안 올라감).
# themoviedb.org > 설정 > API 화면의 값 중 하나만 넣으면 된다.
#   TMDB_ACCESS_TOKEN: "API 읽기 액세스 토큰" (긴 값, 권장)
#   TMDB_API_KEY:      "API 키" (짧은 값)
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# 받아올 정보의 언어 (줄거리·회차 제목 등)
TMDB_LANGUAGE=ko-KR
